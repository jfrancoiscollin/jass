    "metadata_only_audit": true
  },
  "three_state_rule": {
    "PASS": "Complete conforming G0-A/B/C/D data satisfy all frozen thresholds; opens only the already-preregistered strength stage, never promotion.",
    "FAIL": "Observed A/B/D threshold failure, or complete-data G0-C threshold failure, retains the frozen FAIL mapping.",
    "ABSTAIN": "Valid identity, trace parity and execution; no other observed threshold failure; required candidate G0-C Exact/full-root receipt absent. Its absence alone returns ABSTAIN_REQUIRES_SEPARATE_STRENGTH_ADJUDICATION, never PASS or scientific FAIL.",
    "TECHNICAL": "Identity drift, malformed or incomplete trace provenance, or an unexecuted search is a technical block.",
    "unchanged_thresholds": {
      "g0_a": {
        "metric": "exp(q025(mean(log(candidate_nps/parent_nps))))",
        "operator": ">=",
        "threshold": 0.8
      },
      "g0_b": {
        "metric": "q025(mean(candidate_completed_depth-parent_completed_depth))",
        "operator": ">=",
        "threshold": -1.0
      },
      "g0_c_complete_data": {
        "target_depth": "max(1,parent_completed_depth_at_200k-1)",
        "metric": "exp(q975(mean(log(candidate_nodes_to_target/parent_nodes_to_target))))",
        "operator": "<=",
        "threshold": 1.5
      },
      "g0_d": {
        "deep_reference": "CURRICULUM_1M",
        "metric": "q025(mean(I_candidate_200k_matches_1m-I_parent_200k_matches_1m))",
        "operator": ">=",
        "threshold": -0.05
      }
    },
    "precedence": [
      "Invalid identity, execution or trace provenance -> TECHNICAL",
      "Otherwise, any observed numerical threshold failure -> FAIL, even with absent C",
      "Otherwise, valid missing required C Exact receipt -> ABSTAIN_REQUIRES_SEPARATE_STRENGTH_ADJUDICATION",
      "Otherwise, complete conforming A/B/C/D -> PASS"
    ]
  },
