  "scope": {
    "question": "Can G0 preserve its catastrophe-screening role without treating a valid but absent same-search Exact/full-root G0-C receipt as scientific catastrophe?",
    "hypothesis": "A three-state interpretation can preserve all frozen numerical safety floors while routing valid G0-C missingness to separate strength adjudication.",
    "activation": false,
